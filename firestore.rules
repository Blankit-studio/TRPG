rules_version = '2';

// TRPG — Firestore 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에 그대로 붙여넣고 "게시"하세요.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function gmOf(campaignId) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId)).data.gmUid;
    }

    // ── 사용자 프로필: users/{uid} ──
    match /users/{uid} {
      allow get, list: if true;                       // 프로필은 공개
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // ── 플레이 설정 템플릿: templates/{tid} ──
    match /templates/{tid} {
      // 단건 조회: 비공개가 아니면 누구나, 비공개면 본인만
      allow get: if resource == null
                 || resource.data.visibility != 'private'
                 || (signedIn() && resource.data.ownerUid == request.auth.uid);
      // 목록: 공개 템플릿 또는 본인 소유
      allow list: if resource.data.visibility == 'public'
                  || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ── 캐릭터 시트: characters/{cid} ──
    match /characters/{cid} {
      allow get: if resource == null
                 || resource.data.visibility != 'private'
                 || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow list: if resource.data.visibility == 'public'
                  || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ── 캠페인(모집/기록): campaigns/{id} ──
    match /campaigns/{id} {
      // 단건 조회: 비공개가 아니면 누구나, 비공개면 GM 또는 참여 멤버만
      allow get: if resource == null
                 || resource.data.visibility != 'private'
                 || (signedIn() && (resource.data.gmUid == request.auth.uid
                       || request.auth.uid in resource.data.memberUids));
      // 목록: 공개 캠페인, 또는 본인이 GM, 또는 참여 멤버
      allow list: if resource.data.visibility == 'public'
                  || (signedIn() && (resource.data.gmUid == request.auth.uid
                        || request.auth.uid in resource.data.memberUids));
      allow create: if signedIn() && request.resource.data.gmUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.gmUid == request.auth.uid;

      // 세션 기록: 누구나 열람, GM만 작성/수정/삭제
      match /sessions/{sid} {
        allow read: if true;
        allow create, update, delete: if signedIn() && gmOf(id) == request.auth.uid;
      }

      // 모집 신청: 문서 ID = 신청자 uid (1인 1신청)
      match /applications/{applicantUid} {
        allow read: if true;
        // 본인 명의로만 신청
        allow create: if signedIn()
                      && request.auth.uid == applicantUid
                      && request.resource.data.byUid == request.auth.uid;
        // 신청자 본인(메시지 수정) 또는 GM(수락/거절 상태 변경)
        allow update: if signedIn()
                      && (request.auth.uid == applicantUid || gmOf(id) == request.auth.uid);
        // 신청자 본인 또는 GM이 삭제
        allow delete: if signedIn()
                      && (request.auth.uid == applicantUid || gmOf(id) == request.auth.uid);
      }

      // 실시간 플레이 로그(주사위/채팅): 누구나 열람
      match /rolls/{rid} {
        allow read: if true;
        // 로그인(게스트 포함) 후 본인 명의로만 작성
        allow create: if signedIn() && request.resource.data.byUid == request.auth.uid;
        // 작성자 본인 또는 GM이 삭제
        allow delete: if signedIn()
                      && (request.auth.uid == resource.data.byUid || gmOf(id) == request.auth.uid);
      }
    }
  }
}
