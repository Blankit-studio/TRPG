rules_version = '2';

// TRPG — Firestore 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에 그대로 붙여넣고 "게시"하세요.
// (GitHub Pages 배포는 사이트 파일만 올리므로, 규칙은 콘솔에서 직접 게시해야 적용됩니다.)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function campaignData(campaignId) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId)).data;
    }
    function isGM(campaignId) {
      return signedIn() && campaignData(campaignId).gmUid == request.auth.uid;
    }
    // 캠페인 본문을 볼 수 있는 사람만 그 하위 데이터(세션·플레이 로그)도 볼 수 있음
    function canReadCampaign(campaignId) {
      let c = campaignData(campaignId);
      return c.visibility != 'private'
          || (signedIn() && (c.gmUid == request.auth.uid || request.auth.uid in c.memberUids));
    }

    // ── 사용자 프로필: users/{uid} ── 본인만 읽고 쓸 수 있음
    // (이전 규칙은 누구나 목록 조회가 가능해 가입자 이메일이 노출될 수 있었음)
    match /users/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // ── 플레이 설정 템플릿: templates/{tid} ──
    match /templates/{tid} {
      // 단건 조회: 비공개가 아니면 누구나, 비공개면 본인만
      allow get: if resource == null
                 || resource.data.visibility != 'private'
                 || (signedIn() && resource.data.ownerUid == request.auth.uid);
      // 목록: 공개 템플릿 또는 본인 소유
      allow list: if resource.data.visibility == 'public'
                  || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ── 캐릭터 시트: characters/{cid} ──
    match /characters/{cid} {
      allow get: if resource == null
                 || resource.data.visibility != 'private'
                 || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow list: if resource.data.visibility == 'public'
                  || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ── 캠페인(모집/기록): campaigns/{id} ──
    match /campaigns/{id} {
      // 단건 조회: 비공개가 아니면 누구나, 비공개면 GM 또는 참여 멤버만
      allow get: if resource == null
                 || resource.data.visibility != 'private'
                 || (signedIn() && (resource.data.gmUid == request.auth.uid
                       || request.auth.uid in resource.data.memberUids));
      // 목록: 공개 캠페인, 또는 본인이 GM, 또는 참여 멤버
      allow list: if resource.data.visibility == 'public'
                  || (signedIn() && (resource.data.gmUid == request.auth.uid
                        || request.auth.uid in resource.data.memberUids));
      allow create: if signedIn() && request.resource.data.gmUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.gmUid == request.auth.uid;

      // 세션 기록: 캠페인을 볼 수 있는 사람만 열람, GM 만 작성/수정/삭제
      match /sessions/{sid} {
        allow read: if canReadCampaign(id);
        allow create, update, delete: if isGM(id);
      }

      // 모집 신청: 문서 ID = 신청자 uid (1인 1신청)
      // 신청 메시지는 GM 과 신청자 본인만 볼 수 있음
      match /applications/{applicantUid} {
        allow read: if signedIn() && (request.auth.uid == applicantUid || isGM(id));
        // 본인 명의로만, '대기 중' 상태로만 신청 가능 (스스로 '수락됨'으로 만들 수 없음)
        allow create: if signedIn()
                      && request.auth.uid == applicantUid
                      && request.resource.data.byUid == request.auth.uid
                      && request.resource.data.status == 'pending';
        // GM 은 상태 변경 가능 · 신청자 본인은 상태를 바꾸지 않는 수정만 가능
        allow update: if isGM(id)
                      || (signedIn()
                          && request.auth.uid == applicantUid
                          && request.resource.data.status == resource.data.status
                          && request.resource.data.byUid == resource.data.byUid);
        // 신청자 본인 또는 GM 이 삭제
        allow delete: if signedIn() && (request.auth.uid == applicantUid || isGM(id));
      }

      // 실시간 플레이 로그(주사위/채팅): 캠페인을 볼 수 있는 사람만 열람·작성
      match /rolls/{rid} {
        allow read: if canReadCampaign(id);
        // 로그인(게스트 포함) 후 본인 명의로만, 형식이 맞는 기록만 작성
        allow create: if signedIn()
                      && canReadCampaign(id)
                      && request.resource.data.byUid == request.auth.uid
                      && request.resource.data.type in ['roll', 'chat']
                      && (request.resource.data.type != 'chat'
                          || (request.resource.data.text is string
                              && request.resource.data.text.size() <= 2000));
        // 작성자 본인 또는 GM 이 삭제
        allow delete: if signedIn()
                      && (request.auth.uid == resource.data.byUid || isGM(id));
      }
    }
  }
}
